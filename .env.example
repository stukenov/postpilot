# ── Threads ──────────────────────────────────────────────
THREADS_APP_ID=
THREADS_META_APP_ID=
THREADS_APP_SECRET=
THREADS_REDIRECT_URI=https://your-domain.com/callback
THREADS_CALLBACK_BIND_URI=http://127.0.0.1:8787/callback
THREADS_ACCESS_TOKEN=
THREADS_API_BASE=https://graph.threads.net/v1.0
THREADS_SCOPES=threads_basic,threads_content_publish,threads_manage_insights
THREADS_PUBLISH_BACKEND=playwright
THREADS_TIMEZONE=UTC
THREADS_MAX_TEXT_CHARS=500
THREADS_MAX_PUBLISH_LAG_SECONDS=900
THREADS_NODE_BIN=node
THREADS_PLAYWRIGHT_STORAGE_STATE=state/threads-browser-auth.json
THREADS_PLAYWRIGHT_PROFILE_DIR=.playwright-meta-profile
THREADS_PLAYWRIGHT_PROFILE_URL=https://www.threads.com/@your_username
THREADS_PLAYWRIGHT_HEADLESS=true
THREADS_OAUTH_PROXY_CONTAINER=
PLAYWRIGHT_BROWSERS_PATH=.playwright-browsers

# Debug / observability
THREADS_DEBUG_LOG_PATH=state/threads-publisher-debug.jsonl
THREADS_DEBUG_ARTIFACTS_DIR=state/publish-debug
THREADS_DEBUG_CAPTURE_SUCCESS_ARTIFACTS=false
THREADS_DEBUG_POST_RESOLUTION_TIMEOUT_MS=30000
THREADS_DEBUG_POST_RESOLUTION_POLL_MS=2000
THREADS_DEBUG_PROFILE_LINK_LIMIT=5
THREADS_TOKEN_REFRESH_MIN_AGE_SECONDS=86400

# ── LinkedIn ─────────────────────────────────────────────
LINKEDIN_PUBLISH_BACKEND=playwright
LINKEDIN_NODE_BIN=node
LINKEDIN_PLAYWRIGHT_STORAGE_STATE=state/linkedin-browser-auth.json
LINKEDIN_PLAYWRIGHT_HEADLESS=true

# ── Facebook ─────────────────────────────────────────────
FACEBOOK_PUBLISH_BACKEND=playwright
FACEBOOK_NODE_BIN=node
FACEBOOK_PLAYWRIGHT_STORAGE_STATE=state/facebook-browser-auth.json
FACEBOOK_PLAYWRIGHT_HEADLESS=true

# ── AI Content Generation (optional) ────────────────────
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash
OPENROUTER_REVIEW_MODEL=google/gemini-2.5-pro
OPENROUTER_REWRITE_MODEL=google/gemini-2.5-flash
THREADS_GENERATE_SLOTS=09-00,10-30,12-00,13-30,15-00,16-30,18-00,19-30,21-00,22-00
THREADS_GENERATE_LOOKBACK_DAYS=14
